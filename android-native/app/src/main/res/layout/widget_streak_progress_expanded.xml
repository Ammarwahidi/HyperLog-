<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:orientation="vertical"
    android:padding="13dp">

    <!-- Expanded Display Header: Crest + Full Week Subtitle + Prominent Streak Counter -->
    <LinearLayout
        android:id="@+id/widget_header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_hyperlog_crest" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="HyperLog · Mesocycle Dashboard"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="Wk 3 · Target 1–2 RIR · Best Streak 4d"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_streak_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_streak_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="11dp"
            android:paddingTop="5dp"
            android:paddingRight="11dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/widget_streak_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="🔥 4d Streak"
                android:textColor="#FDBA74"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 7-Day Consistency RemoteViews GridLayout -->
    <GridLayout
        android:id="@+id/widget_days_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:alignmentMode="alignBounds"
        android:columnCount="7"
        android:rowCount="1">

        <TextView
            android:id="@+id/widget_day_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:layout_marginEnd="2.5dp"
            android:background="@drawable/widget_day_cell_active"
            android:gravity="center"
            android:paddingTop="3.5dp"
            android:paddingBottom="3.5dp"
            android:singleLine="true"
            android:text="M ●"
            android:textColor="#BAE6FD"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_day_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:layout_marginStart="2.5dp"
            android:layout_marginEnd="2.5dp"
            android:background="@drawable/widget_day_cell_active"
            android:gravity="center"
            android:paddingTop="3.5dp"
            android:paddingBottom="3.5dp"
            android:singleLine="true"
            android:text="T ●"
            android:textColor="#BAE6FD"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_day_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:layout_marginStart="2.5dp"
            android:layout_marginEnd="2.5dp"
            android:background="@drawable/widget_day_cell_idle"
            android:gravity="center"
            android:paddingTop="3.5dp"
            android:paddingBottom="3.5dp"
            android:singleLine="true"
            android:text="W ○"
            android:textColor="#64748B"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_day_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:layout_marginStart="2.5dp"
            android:layout_marginEnd="2.5dp"
            android:background="@drawable/widget_day_cell_active"
            android:gravity="center"
            android:paddingTop="3.5dp"
            android:paddingBottom="3.5dp"
            android:singleLine="true"
            android:text="T ●"
            android:textColor="#BAE6FD"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_day_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:layout_marginStart="2.5dp"
            android:layout_marginEnd="2.5dp"
            android:background="@drawable/widget_day_cell_today"
            android:gravity="center"
            android:paddingTop="3.5dp"
            android:paddingBottom="3.5dp"
            android:singleLine="true"
            android:text="F ●"
            android:textColor="#FDBA74"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_day_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:layout_marginStart="2.5dp"
            android:layout_marginEnd="2.5dp"
            android:background="@drawable/widget_day_cell_idle"
            android:gravity="center"
            android:paddingTop="3.5dp"
            android:paddingBottom="3.5dp"
            android:singleLine="true"
            android:text="S ○"
            android:textColor="#64748B"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_day_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:layout_marginStart="2.5dp"
            android:background="@drawable/widget_day_cell_idle"
            android:gravity="center"
            android:paddingTop="3.5dp"
            android:paddingBottom="3.5dp"
            android:singleLine="true"
            android:text="S ○"
            android:textColor="#64748B"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </GridLayout>

    <!-- Primary 2-Column RemoteViews GridLayout: Total Mesocycle Volume + Daily Nutrition -->
    <GridLayout
        android:id="@+id/widget_primary_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alignmentMode="alignBounds"
        android:columnCount="2"
        android:rowCount="1">

        <LinearLayout
            android:id="@+id/widget_col_training"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:layout_marginEnd="5dp"
            android:background="@drawable/widget_section_bg"
            android:orientation="vertical"
            android:padding="9dp">

            <TextView
                android:id="@+id/widget_sets_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="TOTAL MESOCYCLE SETS"
                android:textColor="#93C5FD"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_sets_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:text="68 / 145 sets"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/widget_sets_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="4dp"
                android:max="100"
                android:progress="47"
                android:progressDrawable="@drawable/widget_progress_sets" />

            <TextView
                android:id="@+id/widget_sets_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="47% of Week 3 · Tap to Track →"
                android:textColor="#94A3B8"
                android:textSize="9.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_col_calories"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_section_bg"
            android:orientation="vertical"
            android:padding="9dp">

            <TextView
                android:id="@+id/widget_kcal_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="TODAY NUTRITION"
                android:textColor="#FDBA74"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_kcal_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:text="1,950 / 2,950 kcal"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/widget_kcal_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="4dp"
                android:max="100"
                android:progress="66"
                android:progressDrawable="@drawable/widget_progress_kcal" />

            <TextView
                android:id="@+id/widget_kcal_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="Protein 154/173g · Tap Meals →"
                android:textColor="#94A3B8"
                android:textSize="9.5sp" />
        </LinearLayout>
    </GridLayout>

    <!-- Full-Width 2x2 RemoteViews GridLayout for Weekly Mesocycle Split Set Progress Bars -->
    <GridLayout
        android:id="@+id/widget_meso_bars_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="7dp"
        android:layout_weight="1"
        android:alignmentMode="alignBounds"
        android:background="@drawable/widget_section_bg"
        android:columnCount="2"
        android:padding="9dp"
        android:rowCount="2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill_horizontal|center_vertical"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_split_0_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="Upper Push · 16 / 32 sets"
                android:textColor="#E2E8F0"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/widget_split_0_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5.5dp"
                android:layout_marginTop="2.5dp"
                android:max="100"
                android:progress="50"
                android:progressDrawable="@drawable/widget_progress_sets" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill_horizontal|center_vertical"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_split_1_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="Back &amp; Rear · 18 / 38 sets"
                android:textColor="#E2E8F0"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/widget_split_1_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5.5dp"
                android:layout_marginTop="2.5dp"
                android:max="100"
                android:progress="47"
                android:progressDrawable="@drawable/widget_progress_emerald" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill_horizontal|center_vertical"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_split_2_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="Arms (Bi/Tri) · 14 / 30 sets"
                android:textColor="#E2E8F0"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/widget_split_2_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5.5dp"
                android:layout_marginTop="2.5dp"
                android:max="100"
                android:progress="46"
                android:progressDrawable="@drawable/widget_progress_cyan" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_gravity="fill_horizontal|center_vertical"
            android:layout_marginStart="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_split_3_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="Legs &amp; Core · 20 / 45 sets"
                android:textColor="#E2E8F0"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/widget_split_3_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5.5dp"
                android:layout_marginTop="2.5dp"
                android:max="100"
                android:progress="44"
                android:progressDrawable="@drawable/widget_progress_kcal" />
        </LinearLayout>
    </GridLayout>

    <!-- Hidden Protein Sub-IDs Not Needed Here, Kept Optional via Tier Check -->
    <TextView
        android:id="@+id/widget_protein_label"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/widget_protein_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
